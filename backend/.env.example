# Copy to .env locally. Never commit real credentials.
PORT=4000
DEFAULT_CLINIC_ID=default

# MongoDB Atlas > Connect > Drivers. URL-encode reserved characters in the DB password.
MONGO_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/<database>?retryWrites=true&w=majority

# Firebase Console > Project settings > Service accounts; keep this private to the server.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Comma-separated exact frontend origins; no wildcard in production.
CLIENT_ORIGINS=http://localhost:5173

# One-time staff provisioning. Use Firebase Auth UIDs created by an administrator.
SEED_EMPLOYEE_UID=
SEED_EMPLOYEE_NAME=Clinic Employee
SEED_DOCTOR_UID=
SEED_DOCTOR_NAME=Clinic Doctor
SEED_DOCTOR_SPECIALTY=General Medicine
SEED_DOCTOR_PUBLIC_BOOKING=true
SEED_DEMO_DATA=false

# For a reviewed legacy migration only; never leave either enabled by default.
CONFIRM_LEGACY_MIGRATION=
ALLOW_PRODUCTION_MIGRATION=
